# 公開サイトURL（canonical / OGP / sitemap に使用）
# 末尾スラッシュなしで指定してください
NEXT_PUBLIC_SITE_URL=https://kabuonkei.com

# Google Analytics Measurement ID（例: G-XXXXXXXXXX）
# 未設定の場合、GA タグは一切出力されません
NEXT_PUBLIC_GA_ID=

# Google Search Console サイト所有権確認コード（例: abcd1234...）
# 未設定の場合、verification メタタグは出力されません
GOOGLE_SITE_VERIFICATION=

# --- X（Twitter）Bot 用 ---
# 投稿スクリプト（npm run post:daily-tweet）のローカル検証で使用。
# 本番は GitHub Secrets に設定し、Actions から渡される。
# X Developer Portal で OAuth 1.0a User Context の Read and Write 権限で発行。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 温度アラート（メール通知）用 ---
# Resend API Key（https://resend.com/）。無料 3,000 通/月。
RESEND_API_KEY=
# 送信元メールアドレス。初期は onboarding@resend.dev（検証不要）で動作確認し、
# 本番前に kabuonkei.com の SPF/DKIM/DMARC を整備してから alerts@kabuonkei.com に切替。
RESEND_FROM_EMAIL=onboarding@resend.dev

# Upstash Redis REST（Vercel Marketplace で Upstash for Redis を integrate すると
# Vercel 側では以下の KV_* 名で自動注入される。GitHub Actions 側の Secrets にも
# 同じ名前で手動コピーすること。上流互換で UPSTASH_REDIS_REST_* も fallback 対応。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 確認・配信解除トークンの HMAC 秘密鍵（32 バイト以上）。
# 生成例: openssl rand -hex 32
ALERTS_TOKEN_SECRET=

# /api/alerts/subscribe の Origin ホワイトリスト（カンマ区切り）。
# 未設定なら NEXT_PUBLIC_SITE_URL と *.vercel.app のみ許可。
ALERTS_ALLOWED_ORIGINS=
